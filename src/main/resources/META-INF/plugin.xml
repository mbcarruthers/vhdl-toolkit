<idea-plugin>
    <id>dev.vhdltoolkit.vhdl</id>
    <name>VHDL Toolkit</name>
    <vendor>VHDL Toolkit Project</vendor>

    <description><![CDATA[
        <p>VHDL support for CLion, powered by the open-source
        <a href="https://github.com/VHDL-LS/rust_hdl">VHDL-LS</a> language server.</p>
        <ul>
            <li>Syntax highlighting for <code>.vhd</code> / <code>.vhdl</code> (VHDL-2008 lexing)</li>
            <li>Semantic colouring: types, design units, libraries, packages, subprogram calls,
                labels, declared objects and attributes each get their own colour, customizable
                under Settings | Editor | Color Scheme | VHDL</li>
            <li>Live diagnostics, go to definition, find references, completion, hover and rename via VHDL-LS</li>
            <li>Comment/uncomment with <code>--</code>, parenthesis matching</li>
            <li>VHDL-LS binary bundled for Linux and Windows x86_64; other platforms use <code>vhdl_ls</code> from PATH</li>
        </ul>
        <p><b>Vivado and Sigasi projects configure themselves.</b> Open a directory containing a
        Vivado <code>.xpr</code> or a Sigasi <code>.library_mapping.xml</code> and the plugin offers
        to derive <code>vhdl_ls.toml</code> from it — filesets, per-file libraries and the project
        default library included — then keeps it in step as the project file changes. Run it again
        any time from <b>Tools | Sync VHDL Library Mapping</b>.</p>
        <p><b>Cascaded errors are collapsed.</b> A typo in a <code>use</code> clause makes every
        name from that package unresolvable, which can turn one mistake into dozens of errors and
        bury the real one. The plugin reconstructs the causal chain and reports only the root
        cause, noting how many other errors follow from it. Toggle it under
        <b>Settings | Languages &amp; Frameworks | VHDL Toolkit</b>.</p>
        <p>Constraints files (<code>.xdc</code>) are highlighted too: constraint commands,
        property names, option switches and Tcl substitution.</p>
        <p>Roadmap: smart <code>end</code> completion, vendor libraries (unisim/xpm),
        and taming cascaded diagnostics.</p>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.lsp</depends>

    <extensions defaultExtensionNs="com.intellij">
        <fileType
            name="VHDL"
            implementationClass="dev.vhdltoolkit.VhdlFileType"
            fieldName="INSTANCE"
            language="VHDL"
            extensions="vhd;vhdl"/>
        <lang.parserDefinition
            language="VHDL"
            implementationClass="dev.vhdltoolkit.VhdlParserDefinition"/>
        <lang.syntaxHighlighterFactory
            language="VHDL"
            implementationClass="dev.vhdltoolkit.highlight.VhdlSyntaxHighlighterFactory"/>
        <lang.commenter
            language="VHDL"
            implementationClass="dev.vhdltoolkit.editing.VhdlCommenter"/>
        <lang.braceMatcher
            language="VHDL"
            implementationClass="dev.vhdltoolkit.editing.VhdlBraceMatcher"/>
        <annotator
            language="VHDL"
            implementationClass="dev.vhdltoolkit.highlight.VhdlAnnotator"/>

        <!-- Typing behaviour. There is no formatting model (no parser), so
             indentation comes from a line indent provider instead. -->
        <lineIndentProvider
            implementation="dev.vhdltoolkit.editing.VhdlLineIndentProvider"/>
        <typedHandler
            implementation="dev.vhdltoolkit.editing.VhdlTypedHandler"/>
        <enterHandlerDelegate
            implementation="dev.vhdltoolkit.editing.VhdlEnterHandler"/>
        <langCodeStyleSettingsProvider
            implementation="dev.vhdltoolkit.editing.VhdlCodeStyleSettingsProvider"/>
        <colorSettingsPage
            implementation="dev.vhdltoolkit.highlight.VhdlColorSettingsPage"/>
        <platform.lsp.serverSupportProvider
            implementation="dev.vhdltoolkit.lsp.VhdlLspServerSupportProvider"/>
        <notificationGroup
            id="VHDL Toolkit"
            displayType="BALLOON"/>
        <postStartupActivity
            implementation="dev.vhdltoolkit.project.VhdlProjectStartupActivity"/>

        <!-- Xilinx design constraints (.xdc), which are Tcl. -->
        <fileType
            name="XDC"
            implementationClass="dev.vhdltoolkit.xdc.XdcFileType"
            fieldName="INSTANCE"
            language="XDC"
            extensions="xdc"/>
        <lang.parserDefinition
            language="XDC"
            implementationClass="dev.vhdltoolkit.xdc.XdcParserDefinition"/>
        <lang.syntaxHighlighterFactory
            language="XDC"
            implementationClass="dev.vhdltoolkit.xdc.XdcSyntaxHighlighterFactory"/>
        <lang.commenter
            language="XDC"
            implementationClass="dev.vhdltoolkit.xdc.XdcCommenter"/>
        <colorSettingsPage
            implementation="dev.vhdltoolkit.xdc.XdcColorSettingsPage"/>
        <applicationConfigurable
            parentId="language"
            instance="dev.vhdltoolkit.settings.VhdlSettingsConfigurable"
            id="dev.vhdltoolkit.settings"
            displayName="VHDL Toolkit"/>

        <!-- Run Vivado in batch mode from the IDE. -->
        <configurationType
            implementation="dev.vhdltoolkit.run.VivadoConfigurationType"/>
    </extensions>

    <actions>
        <action
            id="dev.vhdltoolkit.SyncVhdlMapping"
            class="dev.vhdltoolkit.project.SyncVhdlMappingAction"
            text="Sync VHDL Library Mapping"
            description="Regenerate vhdl_ls.toml from the Vivado or Sigasi project file">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
